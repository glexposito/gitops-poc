# Copy to .env (gitignored) and fill in - read by docker-compose.yaml for
# the github-runner service. Leave GITHUB_PAT empty to keep the runner off.

# Repo the runner registers to (owner/repo).
RUNNER_REPO=glexposito/pulse-api

# Fine-grained PAT, created at https://github.com/settings/personal-access-tokens/new
#   Repository access: only RUNNER_REPO
#   Permissions:       Administration: Read and write
GITHUB_PAT=
