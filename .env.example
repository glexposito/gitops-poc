# Copy to .env (gitignored) - read by docker-compose.yaml for the
# github-runner service. Leave RUNNER_TOKEN empty to keep the runner off.

# Repo the runner registers to (owner/repo).
RUNNER_REPO=glexposito/pulse-api

# One-hour registration token, only needed for the first start (the
# registration is then kept in the github-runner-state volume). Get one from
# the repo's Settings -> Actions -> Runners -> New self-hosted runner, or:
#   gh api -X POST repos/glexposito/pulse-api/actions/runners/registration-token --jq .token
RUNNER_TOKEN=
